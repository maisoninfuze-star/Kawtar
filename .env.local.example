# Copy to .env.local (gitignored) for local testing. In production these live in
# Vercel → Settings → Environment Variables — never in the repo.

# --- Uber Direct (start with the TEST-mode credentials from the Developer tab) ---
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
# Signing key from Dashboard → Developer → Webhooks (required in production)
UBER_DIRECT_WEBHOOK_SECRET=
# Sandbox only — "auto" = Uber robo-courier auto-completes test deliveries (delete for production)
UBER_DIRECT_ROBOCOURIER=auto

# --- Online ordering (Stripe test keys first: sk_test_… / whsec_…) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KITCHEN_PIN=            # 4–8 digits, used on /cuisine.html
GHL_ORDER_WEBHOOK=      # optional: GHL workflow inbound webhook to add SMS on top of the e-mails
SITE_URL=https://www.kawtar.ca

# --- Order e-mails (customer confirmation / ready / en route + Uber tracking link / refund;
#     restaurant alerts). Any SMTP works. Gmail: smtp.gmail.com, 465, the address, an App Password
#     (Google Account → Security → 2-Step Verification → App passwords). ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=             # optional, default "Café Bistro Kawtar <SMTP_USER>"
ORDER_EMAIL_TO=         # restaurant inbox: new-order + delivery-problem alerts, customer reply-to
RESERVE_TO=             # legacy reservation form copy (modal now uses the GHL calendar)
